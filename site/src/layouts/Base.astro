---
// Polices hébergées par le site (aucun appel à Google Fonts)
import "@fontsource/big-shoulders-display/latin-700";
import "@fontsource/big-shoulders-display/latin-800";
import "@fontsource/barlow/latin-400";
import "@fontsource/barlow/latin-500";
import "@fontsource/barlow/latin-600";
import "@fontsource/barlow/latin-700";
import "../styles/global.css";
import { competitions, lire } from "../lib/donnees.js";

const { titre, description, slug, jsonld, actif } = Astro.props;
const comps = competitions();
const comp = slug ? comps.find((c) => c.competition.slug === slug) : comps[0];
const s = comp?.competition.slug;
const nomSite = "Ligue 1 en données";
const titreComplet = titre ? `${titre} · ${nomSite}` : `${nomSite} : stats, prédictions et simulations`;
const canonique = new URL(Astro.url.pathname, Astro.site).href;
const liens = s
  ? [
      ["accueil", "/", "Accueil"],
      ["classement", `/${s}/`, "Classement"],
      ["matchs", `/${s}/matchs/`, "Matchs"],
      ["equipes", `/${s}/equipes/`, "Équipes"],
      ["forces", `/${s}/forces/`, "Puissance"],
      ["historique", `/${s}/historique/`, "Historique"],
      ["comparateur", `/${s}/comparateur/`, "Comparateur"],
      ["cotes", `/${s}/cotes/`, "Cotes"],
      ["predictions", `/${s}/predictions/`, "Nos prédictions"],
      ["methodologie", "/methodologie/", "Méthode"],
    ]
  : [];
const maj = comp?.mis_a_jour;
const aTete = Astro.slots.has("tete");
// Référencement : masqué tant que la variable PUBLIC_INDEXABLE ne vaut pas "true" (à activer au lancement)
const indexable = import.meta.env.PUBLIC_INDEXABLE === "true";
// Quasi-direct : actif seulement si l'adresse du Worker est fournie au build (variable PUBLIC_URL_DIRECT)
const urlDirect = import.meta.env.PUBLIC_URL_DIRECT;
let configDirect = null;
if (urlDirect && comp) {
  const matchs = lire(comp.competition.id, "matchs.json") || [];
  const limite = new Date(new Date(comp.derniere_date_match + "T12:00").getTime() - 5 * 86400000).toISOString().slice(0, 10);
  configDirect = {
    url: `${urlDirect.replace(/\/$/, "")}/direct`,
    prefixe: comp.saison.slice(2, 4) + comp.saison.slice(5, 7),
    joues: matchs.filter((m) => m.statut === "joue" && m.date >= limite).map((m) => m.id),
  };
}
---
<!doctype html>
<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{titreComplet}</title>
    <meta name="description" content={description} />
    {!indexable && <meta name="robots" content="noindex, nofollow" />}
    <meta name="theme-color" content="#0e1620" />
    <link rel="canonical" href={canonique} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="fr_FR" />
    <meta property="og:site_name" content={nomSite} />
    <meta property="og:title" content={titreComplet} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonique} />
    <meta name="twitter:card" content="summary" />
    <link rel="icon" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'><rect width='32' height='32' rx='6' fill='%230e1620'/><path d='M7 22l6-7 5 4 7-10' stroke='%23f0b429' stroke-width='3' fill='none' stroke-linecap='round' stroke-linejoin='round'/></svg>" />
    <link rel="sitemap" href="/sitemap.xml" />
    {jsonld && <script type="application/ld+json" set:html={JSON.stringify(jsonld)} />}
    <script is:inline>
      try {
        const t = localStorage.getItem("theme");
        if (t) document.documentElement.dataset.theme = t;
      } catch (e) {}
    </script>
  </head>
  <body>
    <header class="bandeau">
      <div class="barre">
        <div class="conteneur ligne">
          <a class="logo" href="/">{comp?.competition.nom ?? "Football"} <b>en données</b></a>
          <nav class="nav" aria-label="Navigation principale">
            {liens.map(([id, href, lib]) => <a href={href} aria-current={actif === id ? "page" : undefined}>{lib}</a>)}
          </nav>
          <button class="theme" type="button" id="bouton-theme" aria-label="Basculer clair / sombre">◐</button>
        </div>
      </div>
      {aTete && (
        <div class="conteneur tete">
          <slot name="tete" />
        </div>
      )}
    </header>
    <main class="conteneur">
      <slot />
    </main>
    <footer class="pied">
      <div class="conteneur">
        <span class="logo">{comp?.competition.nom ?? "Football"} <b>en données</b></span>
        <p>Site indépendant et gratuit, construit uniquement à partir de données ouvertes. Aucune affiliation avec la LFP ou les clubs. Aucun conseil de pari.</p>
        {comp && (
          <p>
            Sources :{" "}
            {comp.sources.map((src, i) => (
              <>
                {i > 0 && " · "}
                <a href={src.url} rel="noopener">{src.nom}</a>
              </>
            ))}
            . Calculs, modèles et simulations : ce site.
            {maj && <> Dernière mise à jour : {new Date(maj).toLocaleString("fr-FR", { dateStyle: "long", timeStyle: "short", timeZone: "Europe/Paris" })}.</>}
          </p>
        )}
        {comp?.logos_actifs && <p>Les logos sont la propriété de leurs clubs respectifs et ne sont utilisés que pour identifier les équipes. Ils sont retirés sur simple demande.</p>}
        <p><a href="/methodologie/">Méthodologie</a>{s && <> · <a href={`/${s}/predictions/`}>Précision de nos prédictions</a></>}</p>
      </div>
    </footer>
    {configDirect && <script type="application/json" id="config-direct" set:html={JSON.stringify(configDirect)} />}
    <script>
      import "../scripts/direct.js";
      import "../scripts/tri.js";
    </script>
    <script is:inline>
      document.getElementById("bouton-theme")?.addEventListener("click", () => {
        const r = document.documentElement;
        // Sombre par défaut ; le bouton bascule vers le clair et inversement
        r.dataset.theme = r.dataset.theme === "light" ? "dark" : "light";
        try { localStorage.setItem("theme", r.dataset.theme); } catch (e) {}
      });
      // Infobulles : tout élément portant data-tip
      const tip = document.createElement("div");
      tip.className = "tip";
      tip.hidden = true;
      document.body.append(tip);
      const placer = (e) => {
        const x = Math.max(8, Math.min(e.clientX + 12, innerWidth - tip.offsetWidth - 8));
        const y = e.clientY + 14 + tip.offsetHeight > innerHeight ? e.clientY - tip.offsetHeight - 10 : e.clientY + 14;
        tip.style.left = x + "px";
        tip.style.top = y + "px";
      };
      document.addEventListener("pointerover", (e) => {
        const t = e.target.closest?.("[data-tip]");
        if (!t) { tip.hidden = true; return; }
        tip.textContent = t.getAttribute("data-tip");
        tip.hidden = false;
        placer(e);
      });
      document.addEventListener("pointermove", (e) => { if (!tip.hidden) placer(e); });
      document.addEventListener("scroll", () => (tip.hidden = true), { passive: true });
    </script>
  </body>
</html>
