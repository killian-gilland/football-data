---
// Une ligne de match : heure | domicile | score | extérieur | probabilités.
import ProbaBarre from "./ProbaBarre.astro";
import Club from "./Club.astro";
import { fmt, principalEnjeu, phraseEnjeu } from "../lib/donnees.js";
const { m, ctx, avecDate = false } = Astro.props;
const pred = m.prediction;
const joue = m.statut === "joue";
const res = joue ? Math.sign(m.score[0] - m.score[1]) : null;
const cls = (cote) => (res == null || res === 0 ? "" : (res > 0) === (cote === "dom") ? "gagnant" : "perdant");
const enjeu = m.statut === "a_venir" ? ctx.enjeux?.[m.id] : null;
const grosEnjeu = enjeu && ctx.grosEnjeux?.has(m.id) ? principalEnjeu(enjeu, m) : null;
const quand = avecDate ? `${fmt.date(m.date).replace(/ \d{4}$/, "")}${m.heure ? ` · ${m.heure}` : ""}` : m.heure ?? "";
---
<a class="match" href={ctx.lienMatch(m.id)} data-match={m.id}>
  <span class="heure">{quand}</span>
  <span class={`dom ${cls("dom")}`}><Club id={m.dom} ctx={ctx} logoApres taille={16} /></span>
  <span class={`score ${joue ? "" : "vide"}`}>{joue ? `${m.score[0]} – ${m.score[1]}` : "–"}</span>
  <span class={`ext ${cls("ext")}`}><Club id={m.ext} ctx={ctx} taille={16} /></span>
  <span class="pred">
    {pred && <ProbaBarre p={pred.p} dom={ctx.court(m.dom)} ext={ctx.court(m.ext)} compact source={m.statut === "joue" ? "Notre prédiction avant le match" : "Notre modèle"} />}
    {grosEnjeu && <span class="enjeu" data-tip={`Gros enjeu|${ctx.court(grosEnjeu.equipe)}|${phraseEnjeu(grosEnjeu, ctx.court)}`}>Gros enjeu</span>}
  </span>
</a>
