---
// Barre 1N2 : domicile (bleu), nul (gris), extérieur (orange), valeurs toujours écrites.
import { fmt } from "../lib/donnees.js";
const { p, dom, ext, compact = false } = Astro.props;
const [a, n, b] = p;
---
<div>
  <div class="proba" role="img" aria-label={`${dom} ${fmt.pct(a)}, nul ${fmt.pct(n)}, ${ext} ${fmt.pct(b)}`}>
    <span class="p1" style={`flex:${a}`} data-tip={`Victoire ${dom} : ${fmt.pct(a, 1)}`}></span>
    <span class="pn" style={`flex:${n}`} data-tip={`Match nul : ${fmt.pct(n, 1)}`}></span>
    <span class="p2" style={`flex:${b}`} data-tip={`Victoire ${ext} : ${fmt.pct(b, 1)}`}></span>
  </div>
  <div class="proba-legende">
    <span>{!compact && `${dom} `}<b>{fmt.pct(a)}</b></span>
    <span>{compact ? "nul " : "Nul "}<b>{fmt.pct(n)}</b></span>
    <span>{!compact && `${ext} `}<b>{fmt.pct(b)}</b></span>
  </div>
</div>
