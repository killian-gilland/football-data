---
// Barre 1N2 en relief : toujours les trois mêmes couleurs (victoire domicile, nul, victoire extérieur),
// quel que soit le match, pour qu'on lise la barre d'un coup d'œil. Infobulle détaillée au survol.
import { fmt } from "../lib/donnees.js";
const { p, dom, ext, compact = false, grande = false, source = "Notre modèle" } = Astro.props;
const [a, n, b] = p;
const segs = [
  { v: a, c: "var(--dom)", texte: "#ffffff", lib: `Victoire de ${dom}` },
  { v: n, c: "var(--nul)", texte: "var(--encre)", lib: "Match nul" },
  { v: b, c: "var(--ext)", texte: "#ffffff", lib: `Victoire de ${ext}` },
];
---
<div>
  <div class={`proba3 ${grande ? "grande" : ""}`} role="img" aria-label={`${dom} ${fmt.pct(a)}, nul ${fmt.pct(n)}, ${ext} ${fmt.pct(b)}`}>
    {segs.map((s, i) => (
      <span class="b3" style={`flex:${s.v};--c:${s.c};--i:${i}`} data-tip={`${s.lib}|${fmt.pct(s.v, 1)}|${source}`}>
        {grande && s.v >= 0.12 && <span class="b3-lab" style={`color:${s.texte}`}>{fmt.pct(s.v)}</span>}
      </span>
    ))}
  </div>
  {!grande && (
    <div class="proba-legende">
      <span>{!compact && `${dom} `}<b>{fmt.pct(a)}</b></span>
      <span>{compact ? "nul " : "Nul "}<b>{fmt.pct(n)}</b></span>
      <span>{!compact && `${ext} `}<b>{fmt.pct(b)}</b></span>
    </div>
  )}
  {grande && (
    <div class="proba-legende">
      <span>{dom}</span><span>Nul</span><span>{ext}</span>
    </div>
  )}
</div>
