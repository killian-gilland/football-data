---
// Graphique en lignes (SVG, sans dépendance). Un seul axe Y. Infobulle sur chaque point.
// series : [{ nom, couleur, points: [{ i, y, tip }] }] ; i = position sur l'axe X (0..n-1)
const {
  series = [],
  etiquettesX = [],
  yMin,
  yMax,
  inverse = false,
  hauteur = 220,
  formatY = (v) => String(v),
  ticksY,
  titre,
  diagonale = false,
  xMin,
  xMax,
} = Astro.props;
const W = 640, H = hauteur, ml = 44, mr = 70, mt = 10, mb = 26;
const n = Math.max(etiquettesX.length, ...series.map((s) => s.points.length), 2);
const x0 = xMin ?? 0, x1 = xMax ?? n - 1;
const valeurs = series.flatMap((s) => s.points.map((p) => p.y)).filter((v) => v != null);
const lo = yMin ?? Math.min(...valeurs);
const hi = yMax ?? Math.max(...valeurs);
const X = (i) => ml + ((i - x0) / Math.max(x1 - x0, 1e-9)) * (W - ml - mr);
const Y = (v) => {
  const r = (v - lo) / Math.max(hi - lo, 1e-9);
  return inverse ? mt + r * (H - mt - mb) : H - mb - r * (H - mt - mb);
};
const ticks = ticksY ?? [0, 0.25, 0.5, 0.75, 1].map((k) => lo + k * (hi - lo));
const pasX = Math.max(1, Math.ceil(etiquettesX.length / 7));
// Une valeur manquante coupe la ligne (on ne relie pas deux points à travers un trou).
const chemin = (pts) => {
  let d = "", lever = true;
  for (const p of pts) {
    if (p.y == null) { lever = true; continue; }
    d += `${lever ? "M" : "L"}${X(p.i).toFixed(1)},${Y(p.y).toFixed(1)} `;
    lever = false;
  }
  return d;
};
---
<figure style="margin:0">
  {series.length > 1 && (
    <div class="legende">
      {series.map((s) => <span><i class="pastille" style={`background:${s.couleur}`}></i>{s.nom}</span>)}
    </div>
  )}
  <svg class="graph" viewBox={`0 0 ${W} ${H}`} role="img" aria-label={titre}>
    {ticks.map((t) => (
      <g>
        <line class="grille-l" x1={ml} x2={W - mr} y1={Y(t)} y2={Y(t)} />
        <text x={ml - 6} y={Y(t) + 4} text-anchor="end">{formatY(t)}</text>
      </g>
    ))}
    {diagonale && <line x1={X(x0)} y1={Y(lo)} x2={X(x1)} y2={Y(hi)} stroke="var(--neutre)" stroke-width="1.5" stroke-dasharray="4 4" />}
    {etiquettesX.map((e, i) => (i % pasX === 0 || i === etiquettesX.length - 1) && e != null && (
      <text x={X(i)} y={H - 8} text-anchor="middle">{e}</text>
    ))}
    {series.map((s) => (
      <g>
        {!s.sansLigne && <path d={chemin(s.points)} fill="none" stroke={s.couleur} stroke-width="2" stroke-linejoin="round" stroke-linecap="round" />}
        {s.points.filter((p) => p.y != null).map((p) => (
          <g data-tip={p.tip}>
            <circle cx={X(p.i)} cy={Y(p.y)} r="10" fill="transparent" />
            <circle cx={X(p.i)} cy={Y(p.y)} r={s.points.length > 40 ? 2.5 : 4} fill={s.couleur} stroke="var(--surface)" stroke-width="2" />
          </g>
        ))}
        {series.length <= 4 && s.points.length > 0 && !s.sansEtiquette && (() => {
          const der = [...s.points].reverse().find((p) => p.y != null);
          return der && <text x={X(der.i) + 8} y={Y(der.y) + 4} style="fill:var(--texte-2)">{s.etiquette ?? s.nom}</text>;
        })()}
      </g>
    ))}
  </svg>
</figure>
