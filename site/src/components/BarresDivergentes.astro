---
// Barres de part et d'autre de zéro, en relief : bleu à droite (au-dessus), rouge à gauche (en dessous).
// items : [{ label, valeur, tip }] ; tip au format « titre|valeur|détail » pour l'infobulle riche.
import { fmt } from "../lib/donnees.js";
const { items = [], titre, unite = "pts", gauche, droite } = Astro.props;
const max = Math.max(1, ...items.map((d) => Math.abs(d.valeur ?? 0)));
---
<div class="divergent" role="img" aria-label={titre}>
  {(gauche || droite) && (
    <div class="dv-ligne dv-entete">
      <span></span>
      <span class="dv-g" style="color:var(--div-neg)">{gauche && `← ${gauche}`}</span>
      <span class="dv-d" style="color:var(--div-pos)">{droite && `${droite} →`}</span>
    </div>
  )}
  {items.map((d, i) => {
    const v = d.valeur ?? 0;
    const larg = `${((Math.abs(v) / max) * 100).toFixed(1)}%`;
    const tip = d.tip ?? `${d.label}|${fmt.signe(v)} ${unite}|`;
    return (
      <div class="dv-ligne">
        <span class="dv-lab">{d.label}</span>
        <span class="dv-g">
          {v < 0 && <><em>{fmt.signe(v)} {unite}</em><span class="b3 dv-barre gauche" style={`width:${larg};--c:var(--div-neg);--i:${i}`} data-tip={tip}></span></>}
        </span>
        <span class="dv-d">
          {v >= 0 && <><span class="b3 dv-barre" style={`width:${larg};--c:var(--div-pos);--i:${i}`} data-tip={tip}></span><em>{fmt.signe(v)} {unite}</em></>}
        </span>
      </div>
    );
  })}
</div>
