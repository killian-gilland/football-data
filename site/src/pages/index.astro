---
import Base from "../layouts/Base.astro";
import ListeMatchs from "../components/ListeMatchs.astro";
import Forme from "../components/Forme.astro";
import { competitions, contexte, fmt } from "../lib/donnees.js";

const meta = competitions()[0];
const ctx = contexte(meta.competition.slug);
const accueil = ctx.lire("accueil.json");
const classement = ctx.lire("classement.json");
const simulation = ctx.lire("simulation.json");
const pr = ctx.lire("predictions.json");
const s = ctx.slug;
const matchsJournee = accueil.matchs_journee.map((id) => ctx.parId[id]);
const resultats = accueil.derniers_resultats.map((id) => ctx.parId[id]);
const leader = classement.lignes[0];
const second = classement.lignes[1];
const favori = simulation.equipes.slice().sort((a, b) => b.titre - a.titre)[0];
const menace = simulation.equipes.slice().sort((a, b) => (b.zones.relegation ?? 0) - (a.zones.relegation ?? 0))[0];
const dates = matchsJournee.map((m) => m.date).sort();
const periode = dates.length
  ? `${new Date(dates[0] + "T12:00").toLocaleDateString("fr-FR", { day: "numeric" })} – ${new Date(dates.at(-1) + "T12:00").toLocaleDateString("fr-FR", { day: "numeric", month: "long" })}`
  : "";
const lienTF = (t) => (t.equipe ? ctx.lienEquipe(t.equipe) : t.match_id ? ctx.lienMatch(t.match_id) : null);
---
<Base
  titre={`${meta.competition.nom} ${meta.saison} : stats, prédictions et simulations`}
  description={`${meta.competition.nom} ${meta.saison} par les données : classement, probabilités de chaque match, simulation de fin de saison, stats d'équipes et historique depuis 1993.`}
  slug={s}
  actif="accueil"
>
  <Fragment slot="tete">
    <div style="display:grid;gap:6px">
      <span class="sur-titre">{meta.competition.nom} · saison {meta.saison}</span>
      <h1>{accueil.journee_courante ? `${accueil.journee_courante}e journée` : "Saison en cours"}</h1>
      {periode && <p>{periode} · {matchsJournee.length} matchs · nos probabilités pour chacun</p>}
    </div>
    <div class="affichage">
      <div>
        <span class="etiquette">Leader</span>
        <a class="valeur" href={ctx.lienEquipe(leader.equipe)}>{ctx.court(leader.equipe)}</a>
        <span class="detail">{leader.pts} pts · {leader.pts - second.pts} d'avance sur {ctx.court(second.equipe)}</span>
      </div>
      <div>
        <span class="etiquette">Favori pour le titre</span>
        <span class="valeur">{fmt.pct(favori.titre)}</span>
        <span class="detail">{ctx.court(favori.equipe)}, sur 10 000 simulations</span>
      </div>
      <div>
        <span class="etiquette">Le plus menacé</span>
        <span class="valeur">{fmt.pct(menace.zones.relegation)}</span>
        <span class="detail">{ctx.court(menace.equipe)}, risque de relégation directe</span>
      </div>
      <div>
        <span class="etiquette">Journal public</span>
        <span class="valeur">{pr.n_predictions}</span>
        <span class="detail">prédictions publiées avant les matchs</span>
      </div>
    </div>
  </Fragment>

  <div class="grille-2">
    <section class="section">
      <header>
        <h2>Les matchs de la journée</h2>
        <p class="discret">Probabilités 1 / N / 2 de notre modèle. Touchez un match pour le détail et les scores probables.</p>
      </header>
      <ListeMatchs matchs={matchsJournee} ctx={ctx} />
    </section>

    <div class="colonne">
      <section class="section">
        <header><h2>Classement</h2></header>
        <div class="tableau">
          <table>
            <thead><tr><th class="g" colspan="2">Équipe</th><th>J</th><th>Diff</th><th>Pts</th><th class="g cache-mobile">Forme</th></tr></thead>
            <tbody>
              {classement.lignes.map((l) => (
                <tr>
                  <td class="g rang"><span class={`zone zone-${l.zone}`}></span>{l.rang}</td>
                  <td class="equipe"><a href={ctx.lienEquipe(l.equipe)}>{ctx.court(l.equipe)}</a></td>
                  <td>{l.j}</td><td>{fmt.signe(l.diff, 0)}</td><td class="pts">{l.pts}</td>
                  <td class="g cache-mobile"><Forme resultats={l.forme} /></td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
        <a class="lien-suite" href={`/${s}/`}>Classement détaillé et simulations →</a>
      </section>

      <section class="section">
        <header><h2>À retenir</h2></header>
        <div class="carte">
          <ul style="display:grid;gap:8px">
            {accueil.temps_forts.map((t) => {
              const l = lienTF(t);
              return <li>{l ? <a href={l}>{t.texte}</a> : t.texte}</li>;
            })}
          </ul>
        </div>
      </section>
    </div>
  </div>

  {resultats.length > 0 && (
    <section class="section">
      <header>
        <h2>Résultats de la {accueil.derniere_journee}e journée</h2>
        <p class="discret">Avec la prédiction que notre modèle faisait avant chaque match.</p>
      </header>
      <ListeMatchs matchs={resultats} ctx={ctx} />
    </section>
  )}
</Base>
