---
import Base from "../../../layouts/Base.astro";
import ListeMatchs from "../../../components/ListeMatchs.astro";
import { chemins, contexte } from "../../../lib/donnees.js";

export function getStaticPaths() {
  return chemins();
}
const ctx = contexte(Astro.params.competition);
const { meta } = ctx;
const parJournee = new Map();
for (const m of ctx.matchs) {
  const j = m.journee ?? 0;
  if (!parJournee.has(j)) parJournee.set(j, []);
  parJournee.get(j).push(m);
}
const journees = [...parJournee.keys()].sort((a, b) => a - b);
const courante = meta.journee_courante ?? journees.at(-1);
const ordre = [courante, ...journees.filter((j) => j > courante), ...journees.filter((j) => j < courante).reverse()];
---
<Base
  titre={`Calendrier et résultats ${meta.competition.nom} ${meta.saison}`}
  description={`Tous les matchs de la ${meta.competition.nom} ${meta.saison} : résultats, statistiques et probabilités de chaque match à venir.`}
  slug={ctx.slug}
  actif="matchs"
>
  <Fragment slot="tete">
    <div style="display:grid;gap:6px">
      <span class="sur-titre">{meta.competition.nom} · {meta.saison}</span>
      <h1>Calendrier et résultats</h1>
      <p>Les {ctx.matchs.length} matchs de la saison, journée par journée, avec nos probabilités.</p>
    </div>
    <nav class="puces" aria-label="Aller à la journée">
      {journees.map((j) => <a class="puce" href={`#j${j}`} aria-current={j === courante ? "true" : undefined}>J{j}</a>)}
    </nav>
  </Fragment>
  {ordre.map((j) => (
    <section class="section" id={`j${j}`}>
      <header>
        <span class="sur-titre">{j === courante ? "Journée en cours" : j > courante ? "À venir" : "Jouée"}</span>
        <h2>{j ? `${j}e journée` : "Matchs"}</h2>
      </header>
      <ListeMatchs matchs={parJournee.get(j)} ctx={ctx} />
    </section>
  ))}
</Base>
