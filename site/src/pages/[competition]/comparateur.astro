---
import Base from "../../layouts/Base.astro";
import Comparateur from "../../components/react/Comparateur.jsx";
import { chemins, contexte } from "../../lib/donnees.js";

export function getStaticPaths() {
  return chemins();
}
const ctx = contexte(Astro.params.competition);
const { meta } = ctx;
const equipes = ctx.lire("comparateur.json").map((x) => ({ ...x, nom: ctx.court(x.equipe), logo: ctx.logo(x.equipe) }));
---
<Base
  titre={`Comparateur d'équipes ${meta.competition.nom} ${meta.saison}`}
  description={`Comparez deux équipes de ${meta.competition.nom} ${meta.saison} : profil radar, attaque, défense, tirs, occasions, corners, discipline, forme et note Elo.`}
  slug={ctx.slug}
  actif="comparateur"
>
  <Fragment slot="tete">
    <div style="display:grid;gap:6px">
      <span class="sur-titre">{meta.competition.nom} · {meta.saison}</span>
      <h1>Comparateur d'équipes</h1>
      <p>Deux équipes face à face : leur profil sur le radar, puis chaque statistique ligne par ligne.</p>
    </div>
  </Fragment>
  <Comparateur client:load equipes={equipes} />
</Base>
