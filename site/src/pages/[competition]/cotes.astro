---
import Base from "../../layouts/Base.astro";
import BarresDivergentes from "../../components/BarresDivergentes.astro";
import GraphLignes from "../../components/GraphLignes.astro";
import { chemins, contexte, fmt } from "../../lib/donnees.js";

export function getStaticPaths() {
  return chemins();
}
const ctx = contexte(Astro.params.competition);
const { meta } = ctx;
const c = ctx.lire("cotes.json");
const issueLib = (x) => (x.issue === "nul" ? "Match nul" : `Victoire de ${ctx.court(x.issue === "dom" ? x.dom : x.ext)}`);
const favoris = c?.favoris_par_saison ?? [];
// Exemple concret pour expliquer le calcul : l'équipe la plus au-dessus des attentes
const ex = c?.equipes?.[0];
---
<Base
  titre={`Lecture des cotes ${meta.competition.nom} ${meta.saison} : surprises et équipes sous-estimées`}
  description={`Les plus grosses surprises de la ${meta.competition.nom} et les équipes sous-estimées ou surestimées par les bookmakers, d'après les cotes d'avant-match.`}
  slug={ctx.slug}
  actif="cotes"
>
  <Fragment slot="tete">
    <div style="display:grid;gap:6px">
      <span class="sur-titre">{meta.competition.nom} · {meta.saison}</span>
      <h1>Lecture des cotes</h1>
    </div>
  </Fragment>
  {!c ? <p>Données de cotes non disponibles.</p> : (
    <>
      <p class="discret">
        Les cotes moyennes d'avant-match, une fois la marge des bookmakers retirée, donnent la probabilité que le marché
        attribuait à chaque issue. Elles permettent de repérer les surprises et les équipes que le marché a mal jugées.
        Cette page ne donne aucun conseil de pari.
      </p>

      <h2>Qui fait mieux, ou moins bien, que prévu par les bookmakers ?</h2>
      <div class="grille-2" style="margin-top:14px">
        <div class="colonne" style="gap:10px">
          <p>
            Avant chaque match, les cotes donnent les chances de victoire, de nul et de défaite de chaque équipe. On en
            déduit les points qu'elle « devrait » prendre en moyenne, puis on additionne sur tous ses matchs joués et on
            compare avec les points qu'elle a vraiment pris.
          </p>
          <p class="discret">
            <b>Bleu, vers la droite</b> : l'équipe a pris plus de points que prévu, les bookmakers la sous-estimaient.<br />
            <b>Rouge, vers la gauche</b> : elle en a pris moins, ils la surestimaient. Près de zéro : conforme aux attentes.
          </p>
        </div>
        {ex && (
          <div class="carte" style="gap:6px">
            <span class="sur-titre">Exemple : {ctx.nom(ex.equipe)}</span>
            <p>Les bookmakers attendaient <b>{fmt.num(ex.points_attendus_marche)} points</b> de ses {ex.matchs} premiers matchs. Elle en a pris <b>{ex.points}</b>.</p>
            <p class="chiffre-moyen" style="color:var(--div-pos)">{fmt.signe(ex.ecart)} pts</p>
            <p class="tres-discret">Survolez une barre pour voir le détail de chaque équipe.</p>
          </div>
        )}
      </div>
      <div class="carte">
        <BarresDivergentes gauche="Moins bien que prévu" droite="Mieux que prévu"
          titre="Écart entre points réels et points attendus par le marché"
          items={c.equipes.map((x) => ({ label: ctx.court(x.equipe), valeur: x.ecart,
            tip: `${ctx.court(x.equipe)} : ${x.points} pts pris, ${fmt.num(x.points_attendus_marche)} attendus par les bookmakers (favorite dans ${x.favori} matchs sur ${x.matchs})` }))} />
      </div>

      <div class="grille-2">
        <section>
          <h2>Plus grosses surprises de la saison</h2>
          <div class="tableau"><table>
            <thead><tr><th class="g">Match</th><th class="g">Issue</th><th>Proba. marché</th></tr></thead>
            <tbody>
              {c.surprises_saison.map((x) => (
                <tr><td class="g"><a href={ctx.lienMatch(x.match_id)}>{ctx.court(x.dom)} {x.score} {ctx.court(x.ext)}</a></td>
                  <td class="g">{issueLib(x)}</td><td><b>{fmt.pct(x.proba_marche)}</b></td></tr>
              ))}
            </tbody>
          </table></div>
        </section>
        <section>
          <h2>Plus grosses surprises depuis 2000</h2>
          <div class="tableau"><table>
            <thead><tr><th class="g">Saison</th><th class="g">Match</th><th>Proba.</th></tr></thead>
            <tbody>
              {c.surprises_historiques.map((x) => (
                <tr><td class="g">{x.saison}</td><td class="g">{ctx.court(x.dom)} {x.score} {ctx.court(x.ext)}</td><td><b>{fmt.pct(x.proba_marche, 1)}</b></td></tr>
              ))}
            </tbody>
          </table></div>
        </section>
      </div>

      <h2>Le favori gagne-t-il plus souvent qu'avant ?</h2>
      <p class="discret">Part des matchs remportés par l'équipe favorite des bookmakers, saison par saison.</p>
      <GraphLignes titre="Part des matchs gagnés par le favori" hauteur={200} yMin={0.3} yMax={0.65}
        ticksY={[0.3, 0.4, 0.5, 0.6]} formatY={(v) => fmt.pct(v)}
        etiquettesX={favoris.map((f) => f.saison.slice(2))}
        series={[{ nom: "Favori vainqueur", couleur: "var(--serie-1)", sansEtiquette: true,
          points: favoris.map((f, i) => ({ i, y: f.favori_gagne, tip: `${f.saison} : ${fmt.pct(f.favori_gagne, 1)} (${f.matchs} matchs, ${fmt.pct(f.nuls)} de nuls)` })) }]} />
    </>
  )}
</Base>
